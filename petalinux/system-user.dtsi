/include/ "system-conf.dtsi"
/include/ "pl.dtsi"

/ { 
    reserved-memory {
        #address-cells = <2>;
		#size-cells = <2>;
        ranges;

        psddr0: ddr4@800000000 {
			reg = <0x8 0x00000000 0x0 0x20000000>;
		}; 

    };

    psddr {
        compatible = "mmio-sram";
        memory-region = <&psddr0>;
        export;
    };
    
	plddr0@4000000000 {
        compatible = "mmio-sram";
        reg = <0x40 0x00000000 0x1 0x00000000>;
        export;
    }; 
    
    plddr1@4100000000 {
        compatible = "mmio-sram";
        reg = <0x41 0x00000000 0x1 0x00000000>;
        export;
    }; 
};

&spi0 {
    is-decoded-cs = <0>;
    num-cs = <2>;
    status = "okay";
    
    spidev0@0x00 {
        compatible = "rohm,dh2228fv";
        spi-max-frequency = <50000000>;
        reg = <0>;
    };

    spidev1@0x01 {
        compatible = "rohm,dh2228fv";
        spi-max-frequency = <50000000>;
        reg = <1>;
    };
};

&spi1 {
    is-decoded-cs = <0>;
    num-cs = <2>;
    status = "okay";

    spidev2@0x00 {
        compatible = "rohm,dh2228fv";
        spi-max-frequency = <50000000>;
        reg = <0>;
    };

    spidev3@0x01 {
        compatible = "rohm,dh2228fv";
        spi-max-frequency = <50000000>;
        reg = <1>;
    };
};
	