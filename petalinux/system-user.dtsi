/include/ "system-conf.dtsi"
/include/ "pl.dtsi"

/ {
	
	acadia_ps_ddr: sram@800000000 {
        compatible = "mmio-sram";
		reg = <0x8 0x00000000 0x0 0x40000000>;
		ranges;
		#address-cells = <2>;
		#size-cells = <2>;
        
		psddr0@0 {
			reg = <0x8 0x00000000 0x0 0x40000000>;
		}; 
		
	};
	
};
	